{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/construction/build",
      "destination": "/construction/execution",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api(?:/|$)|ventures(?:/|$)|insights(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
